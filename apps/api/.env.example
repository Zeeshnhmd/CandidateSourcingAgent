# Optional. 5,000 GitHub requests per hour instead of 60. Fine-grained token, public repository read access only.
GITHUB_TOKEN=
# Optional. Enables OpenAI for JD analysis, embeddings and explanations. Without it a deterministic fallback is used.
OPENAI_API_KEY=
PORT=4000

# Optional overrides
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# MOCK_TALENT_URL=http://localhost:3001
# DATA_DIR=./data
# Explicit opt-in mapping of talent network sample profile ids to real public GitHub usernames, e.g. mt-1001:octocat
# GITHUB_PROFILE_MAP=
